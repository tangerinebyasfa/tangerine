NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
# Use your hosted Express URL ending in /api for production.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Optional server-side override for Next.js order proxies. Use the hosted
# Express HTTPS URL ending in /api in production, never the frontend URL.
BACKEND_API_URL=http://localhost:5000/api

# Server-only credentials required by Next.js API handlers when hosted separately.
# Never prefix these with NEXT_PUBLIC_. Set real values in the hosting dashboard.
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
