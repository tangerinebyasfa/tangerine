rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Public catalog data.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subcategories/{subcategoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles:
    // - A signed-in user can create their own doc on signup.
    // - They can read their own doc.
    // - They can update profile fields, but not escalate their role.
    // - Admins can read/update any user doc.
    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;

      allow read: if isOwner(userId) || isAdmin();

      allow update: if isAdmin()
        || (isOwner(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role);

      allow delete: if isAdmin();
    }

    // Wishlist items are private to the signed-in owner.
    match /users/{userId}/wishlist/{productId} {
      allow read, write: if isOwner(userId);
    }

    // Sold-out notification requests are created by signed-in customers and reviewed by admins.
    match /productNotifications/{notificationId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // Saved addresses live in a private subcollection for each user.
    match /users/{userId}/addresses/{addressId} {
      allow read, write: if isOwner(userId);
    }

    // Orders belong to the signed-in user who created them; admins can read all.
    match /orders/{orderId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow update, delete: if isAdmin();
    }

    // Public product review feed contains only customer-facing review data.
    match /productReviews/{productId}/items/{reviewId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
    }

    // Private per-user review history for the logged-in owner.
    match /users/{userId}/reviews/{reviewId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isOwner(userId);
    }

    // Master review records are readable for admins and writable by the author.
    match /reviews/{reviewId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Contact messages can be created by anyone.
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}

