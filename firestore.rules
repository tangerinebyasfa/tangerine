rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// These rules assume the Express backend (using the Admin SDK, which
// bypasses these rules entirely) handles all writes to products,
// categories, orders, and role changes. The client SDK is used directly
// only for: reading products/categories, a user managing their own
// profile doc, and creating a contact message.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Public catalog data - anyone can read, only admins (or the backend,
    // which uses the Admin SDK and skips rules) can write.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users can read/update their own profile (but not their own role -
    // role changes must go through the backend, which uses the Admin SDK).
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    // Orders belong to the user who placed them; admins can see all.
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }

    // Contact form submissions - anyone can create, only admins can read.
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
