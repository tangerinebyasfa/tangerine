# Firebase Admin SDK service account credentials
# Get these from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
#
# Web app Firebase config values like apiKey/authDomain/appId belong in frontend/.env.local.example
# and are not required for this backend Admin SDK setup.
FIREBASE_PROJECT_ID=tangerine-e6d1d
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tangerine-e6d1d.iam.gserviceaccount.com
# Keep the \n escape sequences in the private key when pasting into .env
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=tangerine-e6d1d.firebasestorage.app

PORT=5000
CLIENT_URL=http://localhost:3000
# Optional: comma-separated list of extra frontend origins, e.g. https://app.example.com,https://www.example.com
CLIENT_URLS=
