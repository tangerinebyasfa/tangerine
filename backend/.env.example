# Firebase Admin SDK service account credentials
# Get these from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
#
# Web app Firebase config values like apiKey/authDomain/appId belong in frontend/.env.local
# and are not required for this backend Admin SDK setup.
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the \n escape sequences in the private key when pasting into .env
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

PORT=5000
CLIENT_URL=http://localhost:3000
# Optional: comma-separated list of extra frontend origins, e.g. https://app.example.com,https://www.example.com
CLIENT_URLS=

# Razorpay Standard Checkout (online payments only; there is no cash on delivery)
# Razorpay Dashboard -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
# Keep the secret on the server. Never expose it to the frontend.
RAZORPAY_KEY_SECRET=your_key_secret
# Razorpay Dashboard -> Settings -> Webhooks -> create webhook for
# https://your-api.example.com/api/webhooks/razorpay and copy the secret here.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
