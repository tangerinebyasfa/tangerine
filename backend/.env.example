# Firebase Admin SDK service account credentials
# Get these from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
#
# Web app Firebase config values like apiKey/authDomain/appId belong in frontend/.env.local
# and are not required for this backend Admin SDK setup.
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the \n escape sequences in the private key when pasting into .env
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

PORT=5000
CLIENT_URL=http://localhost:3000
# Optional: comma-separated list of extra frontend origins, e.g. https://app.example.com,https://www.example.com
CLIENT_URLS=

# Razorpay Standard Checkout (online payments only; there is no cash on delivery)
# Razorpay Dashboard -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_TjM9EIYuHccEtG
# Keep the secret on the server. Never expose it to the frontend.
RAZORPAY_KEY_SECRET=IN3UkoNceRwfmidFBM55HeGc
# Razorpay Dashboard -> Settings -> Webhooks -> create webhook for
# https://your-api.example.com/api/webhooks/razorpay and copy the secret here.
RAZORPAY_WEBHOOK_SECRET=razorpaytangerine

# Shiprocket (shipping; orders are created there automatically)
# Dashboard -> Settings -> API -> email + password used for the API token.
SHIPROCKET_EMAIL=tinnkuturkane@gmail.com
SHIPROCKET_PASSWORD=4T5w$J7xk%sVY2j%h8ZcRq%Q%s17Chvf
# The default pickup address used for every API order. Must exactly match an
# address name in Shiprocket (Settings -> Address). With multiple addresses,
# this is the default; any single order can still be reassigned to the other
# address in the Shiprocket panel before dispatch.
SHIPROCKET_PICKUP_LOCATION=Primary
# Optional: Shiprocket channel id; leave blank to use the default channel.
SHIPROCKET_CHANNEL_ID=
# Parcel fallbacks (kg / cm) for products that predate the package fields.
SHIPROCKET_DEFAULT_WEIGHT=0.5
SHIPROCKET_DEFAULT_LENGTH=25
SHIPROCKET_DEFAULT_BREADTH=20
SHIPROCKET_DEFAULT_HEIGHT=5
# Optional: shared secret for tracking webhooks. Append it to the webhook URL
# you register in Shiprocket as ?token=YOUR_TOKEN
SHIPROCKET_WEBHOOK_TOKEN=
